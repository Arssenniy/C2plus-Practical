#include <iostream>
using namespace std;

int main() {
setlocale(0, "");
	int number;
while (true) {
	cout << "Введите число: ";
	cin >> number;
	if (number <= 0) {
		cout << "Нужно положительное число\n";
	}
	else {
		while (number != 0) {
			cout << "" << number-- << endl;
			if (number == 0) {
				cout << "Старт!";
				return 0;
			}
		}
	}
}
return 0;
}

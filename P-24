#include <iostream>;
using namespace std;

int main() {
	setlocale(0, "");

	const int N = 7;
	int massiv[N];
	int number;
	int swap;
	int menu;

	for (int i = 0; i < N; i++) {
		cout << i + 1 << " | Введите массив: ";
		cin >> massiv[i];
	}
	while (true) {
		system("cls");
		cout << "| + | Найстройка массива: \n\n";
		cout << "| 1 | Сортировка по возростанию\n";
		cout << "| 2 | Сортировка по убыванию\n";
		cout << "| 3 | Перемножить массив\n";
		cout << "| 4 | Раздилить массив\n";
		cout << "| 5 | Сложить массив\n";
		cout << "| 6 | Обнулить массив\n\n";
		cout << "| 9 | Задать новые значения массиву\n";
		cout << "| + | Ввод: ";
		cin >> menu;
		switch (menu) {
		case 1:
			swap = 0;
			system("cls");
			cout << "| + | Сортировка по возростанию\n";

			for (int b = 0; b < N; b++) {
				for (int i = 0; i < N - 1; i++) {
					if (massiv[i] > massiv[i + 1]) {
						swap = massiv[i];
						massiv[i] = massiv[i + 1];
						massiv[i + 1] = swap;
					}
				}
			}
			cout << "| + | Массив: ";
			for (int i = 0; i < N; i++) {
				cout << massiv[i] << " ";
			}
			system("pause");
			break;
		case 2:
			swap = 0;
			system("cls");
			cout << "| + | Сортировка по убыванию\n";

			for (int b = 0; b < N; b++) {
				for (int i = 0; i < N - 1; i++) {
					if (massiv[i] < massiv[i + 1]) {
						swap = massiv[i];
						massiv[i] = massiv[i + 1];
						massiv[i + 1] = swap;
					}
				}
			}
			cout << "| + | Массив: ";
			for (int i = 0; i < N; i++) {
				cout << massiv[i] << " ";
			}
			system("pause");
			break;
		case 3:
			system("cls");
			cout << "| + | Перемножить массив\n";
			cout << "| + | Введите число: ";
			cin >> number;

				for (int i = 0; i < N; i++) {
					massiv[i] = massiv[i] * number;
				}

			system("cls");
			cout << "| + | Массив: ";

			for (int i = 0; i < N; i++) {
				cout << massiv[i] << " ";
			}

			system("pause");
			break;
		case 4:
			system("cls");
			cout << "| + | Разделить массив\n";
			cout << "| + | Введите число: ";
			cin >> number;

			for (int i = 0; i < N; i++) {
				massiv[i] = massiv[i] / number;
			}

			system("cls");
			cout << "| + | Массив: ";

			for (int i = 0; i < N; i++) {
				cout << massiv[i] << " ";
			}

			system("pause");
			break;
		case 5:
			system("cls");
			cout << "| + | Сложить массив\n";
			cout << "| + | Введите число: ";
			cin >> number;

			for (int i = 0; i < N; i++) {
				massiv[i] = massiv[i] + number;
			}

			system("cls");
			cout << "| + | Массив: ";

			for (int i = 0; i < N; i++) {
				cout << massiv[i] << " ";
			}

			system("pause");
			break;
		case 6:
			system("cls");
			cout << "| + | Обнулить массив\n";

			for (int i = 0; i < N; i++) {
				massiv[i] = 0;
			}

			system("cls");
			cout << "| + | Массив: ";

			for (int i = 0; i < N; i++) {
				cout << massiv[i] << " ";
			}

			system("pause");
			break;
		case 9:
			system("cls");
			for (int i = 0; i < N; i++) {
				cout << i + 1 << " | Введите массив: ";
				cin >> massiv[i];
			}
			system("pause");
			break;
		default:
			cout << "Такого пункта нет в меню\n\n";
			break;
		}
	}

	cout << "\nДля продолжения нажмите Enter...";
	cin.ignore();
	cin.get();
	system("cls");

	return 0;
}
